# Changes under these paths can break the published image in ways the other
# CI jobs don't catch (e2e runs the app from a plain `bun run build`), so a pull
# request that touches one also builds and smoke-tests the image. Read by the
# `changes` job in ci.yml: one extended regex per line, matched from the start
# of each changed path. app/src/cli/bundle.test.ts fails if a file bundled
# into the CLI or the migrator isn't covered here.

# How the image is built and run
app/Dockerfile
app/\.dockerignore
app/docker/
app/next\.config\.ts
app/scripts/build-cli\.mjs
\.github/workflows/
\.github/image-paths

# Dependencies
app/package\.json
app/bun\.lock

# What the CLI and migrator bundle, and the migrations they apply
app/drizzle/
app/src/cli/
app/src/server/db/
app/src/server/domain/slots\.ts
app/src/server/users\.ts
app/src/server/errors\.ts
