# Copy to .env on the VPS (chmod 600). Generate secrets with: openssl rand -hex 32
# (hex, not base64: the DB passwords go into a postgres:// URL, where / and + break it)

# --- Domain / TLS ---------------------------------------------------------
DOMAIN=example.com              # serves app.example.com and recipes.example.com
ACME_EMAIL=you@example.com      # Let's Encrypt account email
TZ=Europe/Berlin

# --- Postgres -------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=
PLANNER_DB_PASSWORD=
MEALIE_DB_PASSWORD=
# Only read on first boot of an empty volume (postgres/init). Changing these
# later requires ALTER ROLE ... PASSWORD inside Postgres as well.

# --- App ------------------------------------------------------------------
APP_IMAGE=ghcr.io/<owner>/scrappy-meals  # <owner> = the GitHub user/org that hosts the repo (lowercase)
APP_TAG=latest                  # image tag to deploy (latest, a version, or sha-...)
AUTH_SECRET=
MEALIE_API_TOKEN=               # create in Mealie: Profile > API Tokens
# Users are not configured here. After the first start, create them with:
#   docker compose exec app scrappy user add

# --- Backups (AWS S3) -----------------------------------------------------
S3_BUCKET=
S3_REGION=eu-central-1
S3_ENDPOINT=                    # leave empty for AWS
BACKUP_AWS_ACCESS_KEY_ID=       # write-only IAM user, see docs/aws-backup-setup.md
BACKUP_AWS_SECRET_ACCESS_KEY=
AGE_RECIPIENT=                  # age public key (age1...); private key stays off the VPS
BACKUP_PING_URL=                # optional healthchecks.io URL
