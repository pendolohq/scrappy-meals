# Copy to .env on the VPS (chmod 600). Generate secrets with: openssl rand -hex 32
# (hex, not base64: the DB passwords go into a postgres:// URL, where / and + break it)
#
# Keep comments on their own line. Compose reads `KEY=   # note` as the value "# note",
# so an empty value followed by a comment is not empty.

# --- Domain / TLS ---------------------------------------------------------
# Serves app.<DOMAIN> and recipes.<DOMAIN>.
DOMAIN=example.com
# Let's Encrypt account email.
ACME_EMAIL=you@example.com
# Your home time zone. "Today" follows each device's own zone; this is the
# fallback until a device has sent it, and the zone of the backups' timestamps.
TZ=Europe/Berlin

# --- Postgres -------------------------------------------------------------
# Only read on first boot of an empty volume (postgres/init). Changing these
# later requires ALTER ROLE ... PASSWORD inside Postgres as well.
POSTGRES_SUPERUSER_PASSWORD=
PLANNER_DB_PASSWORD=
MEALIE_DB_PASSWORD=

# --- Mealie ---------------------------------------------------------------
# Image without the tag; the version is pinned in docker-compose.yml.
# MEALIE_IMAGE=ghcr.io/mealie-recipes/mealie

# --- App ------------------------------------------------------------------
# <owner> = the GitHub user/org that hosts the repo (lowercase).
APP_IMAGE=ghcr.io/<owner>/scrappy-meals
# Image tag to deploy: a release (0.2.0), latest (= newest release, never
# unreleased main), or sha-...
APP_TAG=latest
AUTH_SECRET=
# Create in Mealie, signed in as the planner's own user: Profile > API Tokens.
MEALIE_API_TOKEN=
# Users are not configured here. After the first start, create them with:
#   docker compose exec app scrappy user add

# --- Backups (AWS S3) -----------------------------------------------------
S3_BUCKET=
S3_REGION=eu-central-1
# Leave empty for AWS; set for S3-compatible storage.
S3_ENDPOINT=
# Write-only IAM user, see docs/aws-backup-setup.md.
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
# age public key (age1...); the private key stays off the VPS.
AGE_RECIPIENT=
# Optional healthchecks.io URL.
BACKUP_PING_URL=

# --- Monitoring (optional, Beszel) ----------------------------------------
# Uncomment to run the monitoring hub and agent with `docker compose up -d`.
# COMPOSE_PROFILES=monitoring
# Both shown by the hub when you add this server (docs/deploy.md, "Monitoring").
BESZEL_AGENT_KEY=
BESZEL_AGENT_TOKEN=
