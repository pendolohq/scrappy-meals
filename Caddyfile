{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

app.{$DOMAIN} {
	import common
	reverse_proxy app:3000
}

recipes.{$DOMAIN} {
	import common
	request_body {
		max_size 50MB
	}
	reverse_proxy mealie:9000
}
