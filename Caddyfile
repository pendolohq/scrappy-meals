{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

app.{$DOMAIN} {
	import common
	# No framing, even by recipes.<domain>, which counts as the same site.
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		X-Frame-Options DENY
		# Only the planner scans barcodes, with its own camera.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	}
	reverse_proxy app:3000
}

recipes.{$DOMAIN} {
	import common
	request_body {
		max_size 50MB
	}
	reverse_proxy mealie:9000
}

# The bare domain and www only point people at the planner.
{$DOMAIN}, www.{$DOMAIN} {
	import common
	redir https://app.{$DOMAIN}{uri} permanent
}
